{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/tools/hooks/cc-git-denylist.sh\""
          },
          {
            "type": "command",
            "command": "bash tools/hooks/cc-godot-sandbox.sh"
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash tools/hooks/cc-write-confine.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash tools/hooks/cc-ledger-session.sh",
            "async": true
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash tools/hooks/cc-ledger-subagent.sh",
            "async": true
          }
        ]
      }
    ]
  }
}
