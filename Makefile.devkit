# Makefile.devkit — the gate framework: `check`, the tier seam, `precommit` and
# `milestone`. `agentic-sdlc install-gates` writes it; edit the source, not this.
#
# Your Makefile is one line plus your own targets:
#     include Makefile.devkit
# The kit is the version your uv.lock pins — `uv add --dev agentic-sdlc==X.Y.Z`,
# or a dependency bot's PR — run from the project environment, never uvx.
# Your gates join `check` via `[gates] extra` in devkit.toml. A language kit's
# tier file (GDK_TIERS_MK, default Makefile.tiers) defines its targets and their
# `.PHONY`, and sets GDK_PRECOMMIT_TIERS / GDK_MILESTONE_TIERS. make 3.81 is the floor.
# No `.SHELLFLAGS -e`: the capture helper has to read PIPESTATUS itself.
SHELL := bash
MAKEFLAGS += --warn-undefined-variables --no-print-directory
.DELETE_ON_ERROR:
.DEFAULT_GOAL := help

# DEVKIT is the kit uv.lock pins, installed in the project environment, where
# `uv sync` puts it when it is missing or older than the lock. A lock that does
# not name the kit stops every target BY NAME, with the command that fixes it.
# Or set DEVKIT to the command itself and there is nothing to resolve.
UV            ?= uv
GDK_VENV      ?= .venv
GDK_KIT_INDEX := https://cdowin.github.io/agentic-sdlc/simple/
ifeq ($(origin DEVKIT),undefined)
ifneq ($(shell grep -qsx 'name = "agentic-sdlc"' uv.lock && echo locked),locked)
$(error uv.lock does not name agentic-sdlc, and the lock is the only way this kit is installed. Run `uv add --dev agentic-sdlc==<X.Y.Z> --index agentic-sdlc=$(GDK_KIT_INDEX)` and add `explicit = true` to the [[tool.uv.index]] table it writes (no pyproject.toml? `uv init --bare` first; one that already declares the kit needs only `uv lock`). Or set DEVKIT to the command that runs the package)
endif
DEVKIT := $(GDK_VENV)/bin/agentic-sdlc
GDK_KIT_FRESH = $(shell test -x $(DEVKIT) && test ! uv.lock -nt $(DEVKIT) && echo fresh)
ifneq ($(GDK_KIT_FRESH),fresh)
GDK_KIT_SYNC := $(shell echo 'Makefile.devkit: $(UV) sync --frozen, for the kit uv.lock pins' >&2; \
                  $(UV) sync --frozen >&2 && touch $(DEVKIT))
ifneq ($(GDK_KIT_FRESH),fresh)
$(error `$(UV) sync --frozen` did not install $(DEVKIT) — read what uv printed above)
endif
endif
endif

# Where `install-gates` put the shell library; moving it means setting this.
GDK_DEV_DIR  ?= tools/dev
GDK_GATE_LIB ?= $(GDK_DEV_DIR)/gdk_gate.sh

# Exported so `make check VERBOSE=1` reaches recipes as well as `VERBOSE=1 make check`.
VERBOSE ?=
export VERBOSE

# The bridge to the ledger: the sourced library cannot see a make variable.
# Empty it and nothing is recorded or spawned.
export GDK_LEDGER_CMD ?= $(DEVKIT)

# Arguments, overridden on the command line:
#   ARGS — passthrough              make sdlc ARGS='dispatch --grain <id>'
# Read with $(value ARGS), so a `$` in free text is never make's to expand, and
# handed to the verb through the ENVIRONMENT (AGENTIC_SDLC_ARGS), never spliced
# into the recipe's shell text: the CLI splits it with shell-style quoting, so
# `(`, `,` and `$` pass as typed. Write an apostrophe in a name as \'.
# The verb runs with ARGS unset and MAKEFLAGS emptied: a sub-make a belt spawns
# never sees your ARGS, through the environment or through MAKEFLAGS. Only the
# `pm` and `sdlc` recipes drop it; your own targets still see `$ARGS`.
ARGS ?=

# Set by `check` when it re-enters itself through a sub-make. See `check`.
GDK_IN_CHECK ?=

# What a FAILING gate shows before its verdict; the rest stays in the log.
GDK_GATE_FAIL_RE    ?= ^(FAILED|ERROR|SCRIPT ERROR)|  DRIFT |\] FAIL|^  (MISS|FALSE POSITIVE)
GDK_GATE_FAIL_LINES ?= 20

# Each gate's one-line summary, read out of its transcript with the tool's `[tag]` stripped.
GDK_SUM_CHECKS := printf '%s check(s) PASS' "$$(grep -acE '^\[check:[a-z-]+\] PASS' "$$log")"
# The last TAGGED line, so a closing pointer is never the summary; the real last line when none is tagged.
GDK_SUM_TAIL   := { grep -aE '^\[[A-Za-z][A-Za-z:_-]*\] ' "$$log" || tail -1 "$$log"; } \
                  | tail -1 | sed -E 's/^\[[a-zA-Z:_-]+\] //'

# $(call gdk_gate,<log slot>,<TAG>,<summary command>,<argv...>[,<census command>])
# Quiet capture, one verdict line, the command's own exit code. The fifth
# argument prints how many things the run walked, for the ledger row;
# guarded on `$(origin 5)` because of --warn-undefined-variables.
# The run captures into `<slot>.<pid>` and renames it onto the slot at the end:
# `$$log` in the summary, census and failure excerpt is THIS run's transcript,
# never a slot a concurrent run of the same gate is appending to, and the slot
# holds the last whole run to finish. Watch a run in flight at `<slot>.*`.
# `gdk_gate_sh` is the same text with no `@`, for a recipe that runs it inside
# a larger shell line (`check`); it reads the positionals of the call around it.
define gdk_gate
@$(gdk_gate_sh)
endef

define gdk_gate_sh
set -o pipefail; . $(GDK_GATE_LIB); \
slot="$$(gdk_gate_log $(1))"; log="$$slot.$$$$"; : > "$$log"; \
gdk_on_exit 'rm -f -- "$$log"'; \
gdk_gate_capture "$$log" -- $(4); \
status="$$GDK_GATE_EXIT"; \
summary="$$($(3))"; \
$(if $(filter-out undefined,$(origin 5)),GDK_GATE_CENSUS="$$($(5))"; export GDK_GATE_CENSUS;) \
if [ "$$status" -ne 0 ]; then \
	grep -aE '$(GDK_GATE_FAIL_RE)' "$$log" | head -$(GDK_GATE_FAIL_LINES) \
		|| tail -$(GDK_GATE_FAIL_LINES) "$$log"; \
	summary="FAIL (exit $$status) — $$summary"; \
fi; \
mv -f -- "$$log" "$$slot"; \
gdk_gate_verdict $(2) "$$summary" "$$slot"; \
exit "$$status"
endef

# Only what this file defines; the tier file declares its own.
.PHONY: help pm sdlc check precommit milestone \
        gdk-tiers-none-precommit gdk-tiers-none-milestone gdk-tiers-skipped-milestone

help: ## Show this help (authoritative target list)
	@echo "make <target> — the gate framework from Makefile.devkit, plus this project's tiers and its own"
	@echo
	@{ grep -hE '^[a-zA-Z0-9_-]+:.*?## .*$$' $(MAKEFILE_LIST) || true; } \
		| sort -u \
		| awk 'BEGIN {FS = ":.*?## "}; {printf "  \033[36m%-18s\033[0m %s\n", $$1, $$2}'
	@echo
	@echo 'Args: ARGS="…"  VERBOSE=1     Tiers: $(GDK_TIERS_MK) -> precommit=[$(strip $(GDK_PRECOMMIT_TIERS))] milestone=[$(strip $(GDK_MILESTONE_TIERS))]'
	@echo 'Gates print ONE verdict line naming .gate-reports/<gate>.log; VERBOSE=1 streams it.'

pm sdlc: export AGENTIC_SDLC_ARGS = $(value ARGS)

pm: ## PM-tree CLI (the ONLY sanctioned status transition):  make pm ARGS='story building <id>'
	@unset ARGS; MAKEFLAGS= $(DEVKIT) pm $(if $(value ARGS),,--help)

sdlc: ## Every verb, at the pin:  make sdlc ARGS='release <version>'. make exits 2 on any failure; the verb's own exit code is the N in make's "Error N"
	@unset ARGS; MAKEFLAGS= $(DEVKIT) $(if $(value ARGS),,--help)

# --- Aggregate gates ----------------------------------------------------------
# `check` is the devkit roster then this project's `[gates] extra`, read once
# by the CLI (a bad value exits 2 rather than narrowing the gate). Every gate
# runs; a red one does not stop the next. With extras declared, the LAST line
# is the verdict over all of them, and the exit is the worst exit any gate
# gave: `[CHECK] PASS — <m> gate(s)` or `[CHECK] FAIL — <n> of <m> gate(s)
# failed: <name>, …`, where `check all` counts as one gate. With none, the
# roster's own verdict is the last line. Re-entry is refused through
# GDK_IN_CHECK. The sub-make is `$${MAKE:-make}`, not `$(MAKE)`, so
# `make -n check` runs nothing.
#
# A gate whose inputs are byte-identical to a recorded PASS is reused (#98):
# `check all` keys each devkit gate on what it reads, and a `[gates] extra`
# target with `[gates.inputs]` declared runs through ONE `gates-extra --run`
# call for all of them (one listing and one read of each path), keyed
# the same way. A `check all` that reused anything and passed creates the
# file GDK_GATE_UNMEASURED names, and its slot files no cost row.
#
# `check pm`'s verdict ends `; <n> close(s) ready to run — <command>` when a
# close whose checks that need no run pass stands open; GDK_SUM_CLOSES lifts
# that clause out of the transcript at `$$log`, with a reuse clause after it
# dropped, and the `[CHECK]` verdict ends with it — a count, never the exit
# code.
GDK_SUM_CLOSES = sed -nE '/^\[check:pm\] (PASS|FAIL) /{s/; reused — .*$$//; s/^.*(; [0-9]+ close\(s\) ready to run — .*)$$/\1/p;}' "$$log" | tail -1
GDK_SUM_CHECK_ALL = printf '%s check(s) PASS%s%s' "$$(grep -acE '^\[check:[a-z-]+\] PASS' "$$log")" \
                    "$$(grep -acE '^\[check:[a-z-]+\] PASS.*; reused — ' "$$log" | sed -E 's/^0$$//; s/^[0-9]+$$/, & reused/')" \
                    "$$($(GDK_SUM_CLOSES))"

check: ## Static gate: the devkit checks + this project's own ([gates] extra); an unchanged gate is reused
	@test -z "$(GDK_IN_CHECK)" || { echo "make check: re-entered through [gates] extra in devkit.toml — a gate target that runs \`make check\` recurses forever; drop it from that list" >&2; exit 2; }
	@unmeasured="$${GDK_GATE_REPORT_DIR:-.gate-reports}/.check.unmeasured.$$$$"; rm -f -- "$$unmeasured"; \
	( export GDK_GATE_UNMEASURED="$$unmeasured"; \
	  $(call gdk_gate_sh,check,CHECK,$(GDK_SUM_CHECK_ALL),$(DEVKIT) check all) ); \
	worst=$$?; rm -f -- "$$unmeasured"; failed=; n=0; m=1; \
	[ "$$worst" -eq 0 ] || { failed="check all"; n=1; }; \
	extra="$$($(DEVKIT) gates-extra)" || exit $$?; \
	[ -n "$$extra" ] || exit "$$worst"; \
	log="$${GDK_GATE_REPORT_DIR:-.gate-reports}/check.log"; closes="$$($(GDK_SUM_CLOSES))"; \
	reuse="$$($(DEVKIT) gates-extra --inputs)" || exit $$?; \
	reuse=" $$(echo $$reuse) "; batch=; rest=; \
	for target in $$extra; do \
		m=$$((m + 1)); \
		case "$$reuse" in *" $$target "*) batch="$$batch $$target" ;; *) rest="$$rest $$target" ;; esac; \
	done; \
	if [ -n "$$batch" ]; then \
		fails="$${GDK_GATE_REPORT_DIR:-.gate-reports}/.check.extra-failed.$$$$"; rm -f -- "$$fails"; \
		GDK_EXTRA_FAILED="$$fails" $(DEVKIT) gates-extra --run $$batch; rc=$$?; \
		if [ "$$rc" -ne 0 ]; then \
			for target in $$(cat "$$fails" 2>/dev/null || echo gates-extra); do \
				n=$$((n + 1)); failed="$${failed:+$$failed, }$$target"; \
			done; \
			[ "$$rc" -le "$$worst" ] || worst=$$rc; \
		fi; \
		rm -f -- "$$fails"; \
	fi; \
	for target in $$rest; do \
		$${MAKE:-make} GDK_IN_CHECK=1 "$$target" && continue; \
		rc=$$?; n=$$((n + 1)); failed="$${failed:+$$failed, }$$target"; \
		[ "$$rc" -le "$$worst" ] || worst=$$rc; \
	done; \
	if [ "$$n" -eq 0 ]; then echo "[CHECK] PASS — $$m gate(s)$$closes"; \
	else echo "[CHECK] FAIL — $$n of $$m gate(s) failed: $$failed$$closes"; fi; \
	exit "$$worst"

# --- The tier seam ------------------------------------------------------------
# The kit's tier lists, read and guarded at parse time.
GDK_TIERS_MK        ?= Makefile.tiers
GDK_PRECOMMIT_TIERS ?=
GDK_MILESTONE_TIERS ?=
-include $(GDK_TIERS_MK)

# The typo guard: `-include` is silent on a missing file, so a non-empty tier
# list with no file, or a tier no makefile defines, is refused here.
GDK_TIERS_DECLARED := $(strip $(GDK_PRECOMMIT_TIERS) $(GDK_MILESTONE_TIERS))
ifneq (,$(GDK_TIERS_DECLARED))
ifeq (,$(wildcard $(GDK_TIERS_MK)))
$(error GDK_TIERS_MK=$(GDK_TIERS_MK) does not exist yet a tier list names [$(GDK_TIERS_DECLARED)] — `-include` of a missing file is silent by design and this is the typo that silence hides. Point GDK_TIERS_MK at the tier file or clear GDK_PRECOMMIT_TIERS / GDK_MILESTONE_TIERS)
endif
# Explicit target names from the files, since 3.81 has no target introspection;
# a tier defined only by a pattern rule is invisible here.
GDK_TIERS_TARGETS := $(shell awk '/^[A-Za-z0-9][A-Za-z0-9._\/-]*[ \t]*:([^=]|$$)/ { sub(/[ \t]*:.*/, ""); print }' $(MAKEFILE_LIST))
GDK_TIERS_ORPHAN_PRECOMMIT := $(filter-out $(GDK_TIERS_TARGETS),$(GDK_PRECOMMIT_TIERS))
GDK_TIERS_ORPHAN_MILESTONE := $(filter-out $(GDK_TIERS_TARGETS),$(GDK_MILESTONE_TIERS))
ifneq (,$(GDK_TIERS_ORPHAN_PRECOMMIT))
$(error GDK_PRECOMMIT_TIERS names a tier no makefile defines: [$(GDK_TIERS_ORPHAN_PRECOMMIT)] — declared for $(GDK_TIERS_MK); a gate list that quietly gets shorter is the one failure a gate must never have)
endif
ifneq (,$(GDK_TIERS_ORPHAN_MILESTONE))
$(error GDK_MILESTONE_TIERS names a tier no makefile defines: [$(GDK_TIERS_ORPHAN_MILESTONE)] — declared for $(GDK_TIERS_MK); a gate list that quietly gets shorter is the one failure a gate must never have)
endif
endif

# Every declared tier is phony: a same-named directory would otherwise make
# the sub-make skip that goal as up to date, silently.
.PHONY: $(GDK_PRECOMMIT_TIERS) $(GDK_MILESTONE_TIERS)

# The empty case announces itself, as a prerequisite so it is neither timed nor captured.
define gdk_tiers_none
@echo "[TIERS] $(1) is empty — this gate is \`check\` alone; $(GDK_TIERS_MK) $(if $(wildcard $(GDK_TIERS_MK)),declares no tier for it,is not present)"
endef

gdk-tiers-none-precommit:
	$(call gdk_tiers_none,GDK_PRECOMMIT_TIERS)

gdk-tiers-none-milestone:
	$(call gdk_tiers_none,GDK_MILESTONE_TIERS)

# CI can run a milestone tier as a job of its own: the stock verify.yml runs
# the interpreter matrix concurrently and sets GDK_MILESTONE_SKIP=matrix. A tier
# named here leaves `milestone` and the gate SAYS so; a name no milestone tier
# carries leaves nothing, so the stock workflow is safe on a tree with no matrix.
GDK_MILESTONE_SKIP    ?=
GDK_MILESTONE_SKIPPED := $(filter $(GDK_MILESTONE_SKIP),$(GDK_MILESTONE_TIERS))
GDK_MILESTONE_RUN     := $(filter-out $(GDK_MILESTONE_SKIP),$(GDK_MILESTONE_TIERS))

gdk-tiers-skipped-milestone:
	@echo "[TIERS] milestone skips [$(strip $(GDK_MILESTONE_SKIPPED))] — GDK_MILESTONE_SKIP names them, so another job runs them or nothing does"

# --- The compositions ---------------------------------------------------------
# `precommit` and `milestone` run `check` plus the declared tiers as the goals
# of one sub-make inside a slot of their own name, so the ledger gets a row
# for the whole target. Only the members reach the console: the composition's
# own verdict line goes to its transcript. `make -n` still runs nothing. The
# transcript is per run and renamed onto the slot, as in `gdk_gate`.
# $(call gdk_composition,<log slot>,<TAG>,<goals...>)
define gdk_composition
@set -o pipefail; . $(GDK_GATE_LIB); \
slot="$$(gdk_gate_log $(1))"; log="$$slot.$$$$"; : > "$$log"; \
gdk_on_exit 'rm -f -- "$$log"'; verbose="$$VERBOSE"; \
VERBOSE=1 gdk_gate_capture "$$log" -- env $(if $(value 4),$(4) )VERBOSE="$$verbose" $${MAKE:-make} $(3); \
status="$$GDK_GATE_EXIT"; \
summary="PASS ($(strip $(3)))"; \
[ "$$status" -eq 0 ] || summary="FAIL (exit $$status) — $(strip $(3))"; \
gdk_gate_verdict $(2) "$$summary" "$$slot" >> "$$log"; \
mv -f -- "$$log" "$$slot"; \
exit "$$status"
endef

precommit: $(if $(GDK_PRECOMMIT_TIERS),,gdk-tiers-none-precommit) ## Per-change gate: check + GDK_PRECOMMIT_TIERS
	$(call gdk_composition,precommit,PRECOMMIT,check $(GDK_PRECOMMIT_TIERS))

milestone: $(if $(GDK_MILESTONE_TIERS),,gdk-tiers-none-milestone) $(if $(GDK_MILESTONE_SKIPPED),gdk-tiers-skipped-milestone) ## Full gate: check + GDK_MILESTONE_TIERS, less GDK_MILESTONE_SKIP
	$(call gdk_composition,milestone,MILESTONE,check $(GDK_MILESTONE_RUN))
