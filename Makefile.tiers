# Makefile.tiers — godot-devkit's tiers, on the seam Makefile.devkit `-include`s.
#
# The include owns `check`, `precommit` and `milestone`; this file owns what
# those compositions run AFTER `check`, and declares which tier belongs to
# which. A tier named here that no makefile defines is refused at parse time
# by the include — a gate list that quietly gets shorter is the one failure a
# gate must never have.
#
#   unit     the suite minus the spawns (-m "not shell"): seconds, the inner loop
#   test     the whole suite on the PY_FLOOR interpreter: minutes, the per-change close
#   fuzz     the committed seeded harnesses alone (`test` runs them too)
#   matrix   every claimed interpreter, once: the full gate, and what CI runs
#
# `precommit` is check + test; `milestone` is check + matrix (the matrix
# subsumes `test`, so it is not listed twice). The hook corpora are replayed
# by `check hooks` inside `check`, so no tier repeats them.

GDK_PRECOMMIT_TIERS := test
GDK_MILESTONE_TIERS := matrix

.PHONY: unit test fuzz matrix

# Each pytest tier's one-line summary, read back out of its own transcript.
SUM_PYTEST := grep -aoE '[0-9]+ (passed|failed)[^|]*' "$$log" | tail -1

# The narrow slice. ~85% of this suite's wall clock is `subprocess` — bash,
# make, git, the installed hook corpora — and the `shell` mark is DERIVED per
# module in tests/conftest.py from what the source does, never a list here.
# Everything else runs in seconds, which is what an edit-verify loop needs.
unit: ## Narrow tier: the suite minus the spawns (-m "not shell"), seconds
	$(call gdk_gate,unit,UNIT,$(SUM_PYTEST),$(PYTEST) $(PYTEST_Q) -m 'not shell')

test: ## The whole suite on the PY_FLOOR interpreter
	$(call gdk_gate,test,TEST,$(SUM_PYTEST),$(PYTEST) $(PYTEST_Q))

# The seeded harnesses on their own, for when one of them is what you changed.
# `make test` runs them too — they are tests, not a side quest, and a fuzz that
# only runs when somebody remembers it is a fuzz that does not run.
fuzz: ## The committed seeded harnesses (differential + replay)
	$(call gdk_gate,fuzz,FUZZ,$(SUM_PYTEST),$(PYTEST) $(PYTEST_Q) -m fuzz)

# Every interpreter in one target, and it reports which one failed. A matrix
# that stops at the first failure hides the difference between "3.14 only" and
# "everywhere", which is the whole question a matrix is asked. It writes its own
# loop rather than $(call gdk_gate,...) because it captures N runs into ONE
# transcript — but it ends the same way, with one verdict line naming that log.
#
# The FLOOR runs the whole suite; every other interpreter runs `-m "not shell"`
# (a spawn is not something a Python version changes, so four interpreters
# replaying it bought minutes and no information).
#
# A PY_FLOOR that is not in PY_MATRIX is refused BEFORE the first interpreter —
# the slice would then be run by nobody and the matrix would print PASS over a
# suite that never ran, which is worse than the sixteen minutes this saves.
# Membership is decided by the same word splitting the loop uses, so the guard
# and the run cannot disagree; a `case` pattern would call a 3.1 floor a member
# of a 3.11 matrix. (PY_FLOOR/PY_MATRIX are operator configuration: the guard
# is against bumping one and not the other, not against shell injection
# through a make variable.)
matrix: ## Every claimed interpreter ($(PY_MATRIX)): the floor runs everything, the rest -m "not shell"
	@set -o pipefail; . $(GDK_GATE_LIB); \
	log="$$(gdk_gate_log matrix)"; fail=''; floor=''; full=''; \
	for v in $(PY_MATRIX); do [ "$$v" = "$(PY_FLOOR)" ] && floor="$$v"; done; \
	if [ -z "$$floor" ]; then \
		echo 'PY_FLOOR "$(PY_FLOOR)" is not in PY_MATRIX "$(PY_MATRIX)"' >> "$$log"; \
		gdk_gate_verdict MATRIX 'REFUSED: PY_FLOOR "$(PY_FLOOR)" is not in PY_MATRIX "$(PY_MATRIX)", so no interpreter would run the whole suite' "$$log"; \
		exit 2; \
	fi; \
	for v in $(PY_MATRIX); do \
		if [ -z "$$full" ] && [ "$$v" = "$(PY_FLOOR)" ]; then \
			full="$$v"; slice=(); ran='the whole suite'; \
		else \
			slice=(-m 'not shell'); ran='-m "not shell"'; \
		fi; \
		echo "=== python $$v ($$ran) ===" >> "$$log"; \
		[ -z "$$VERBOSE" ] || [ "$$VERBOSE" = "0" ] || echo "=== python $$v ($$ran) ==="; \
		gdk_gate_capture "$$log" -- \
			$(UV) run --python $$v $(TEST_DEPS) python -m pytest $(PYTEST_Q) "$${slice[@]}" || true; \
		[ "$$GDK_GATE_EXIT" -eq 0 ] || fail="$$fail $$v"; \
	done; \
	if [ -n "$$fail" ]; then \
		grep -aE '$(GDK_GATE_FAIL_RE)' "$$log" | head -$(GDK_GATE_FAIL_LINES) || true; \
		gdk_gate_verdict MATRIX "FAIL on$$fail" "$$log"; \
		exit 1; \
	fi; \
	gdk_gate_verdict MATRIX "PASS on $(PY_MATRIX)" "$$log"
