# Makefile.gates — the gate framework: `help`, `check`, `precommit`, `verify`
# and the tier seam. `godot-devkit install-gates` writes it; after that it is
# your repo's file.
#
# Your Makefile sets what is yours, then includes this file:
#
#     GDK_CHECKS := godot-check uid-scan      # make targets that join `check`
#     include Makefile.gates
#
# `check` runs `shell` (shellcheck over every tracked *.sh) and then each
# target named in GDK_CHECKS. Every gate runs; a red one does not stop the
# next. The last line is the verdict over all of them, and the exit is the
# worst exit any gate gave. This file reads no config file.
#
# `precommit` = `check` + GDK_PRECOMMIT_TIERS.
# `verify`    = `check` + GDK_VERIFY_TIERS, less GDK_VERIFY_SKIP.
#
# A language kit's tier file (GDK_TIERS_MK, default Makefile.tiers) defines its
# targets and their `.PHONY`, and sets GDK_PRECOMMIT_TIERS / GDK_VERIFY_TIERS.
# GNU make 3.81 (what macOS ships) is the floor.
# No `.SHELLFLAGS -e`: the capture helper has to read PIPESTATUS itself.
SHELL := bash
MAKEFLAGS += --warn-undefined-variables --no-print-directory
.DELETE_ON_ERROR:
.DEFAULT_GOAL := help

# Where `install-gates` put the shell library; moving it means setting this.
GDK_DEV_DIR  ?= tools/dev
GDK_GATE_LIB ?= $(GDK_DEV_DIR)/gdk_gate.sh

# Exported so `make check VERBOSE=1` reaches recipes as well as `VERBOSE=1 make check`.
VERBOSE ?=
export VERBOSE

# The make targets `check` runs after `shell`. Set it in your Makefile, above
# the include.
GDK_CHECKS ?=

# The shellcheck `shell` runs, and the flags it gets.
GDK_SHELLCHECK       ?= shellcheck
GDK_SHELLCHECK_FLAGS ?=

# Arguments, overridden on the command line:
#   ARGS — passthrough              make integration ARGS="--system input"
ARGS ?=

# Set by `check` when it re-enters itself through a sub-make. See `check`.
GDK_IN_CHECK ?=

# What a FAILING gate shows before its verdict; the rest stays in the log.
GDK_GATE_FAIL_RE    ?= ^(FAILED|ERROR|SCRIPT ERROR)|  DRIFT |\] FAIL|^  (MISS|FALSE POSITIVE)
GDK_GATE_FAIL_LINES ?= 20

# Each gate's one-line summary, read out of its transcript with the tool's `[tag]` stripped.
GDK_SUM_CHECKS := printf '%s check(s) PASS' "$$(grep -acE '^\[check:[a-z-]+\] PASS' "$$log")"
# The last TAGGED line, so a closing pointer is never the summary; the real last line when none is tagged.
GDK_SUM_TAIL   := { grep -aE '^\[[A-Za-z][A-Za-z:_-]*\] ' "$$log" || tail -1 "$$log"; } \
                  | tail -1 | sed -E 's/^\[[a-zA-Z:_-]+\] //'

# $(call gdk_gate,<log slot>,<TAG>,<summary command>,<argv...>)
# Quiet capture, one verdict line, the command's own exit code.
# The run captures into `<slot>.<pid>` and renames it onto the slot at the end:
# `$$log` in the summary and the failure excerpt is THIS run's transcript,
# never a slot a concurrent run of the same gate is appending to, and the slot
# holds the last whole run to finish. Watch a run in flight at `<slot>.*`.
# `gdk_gate_sh` is the same text with no `@`, for a recipe that runs it inside
# a larger shell line; it reads the positionals of the call around it.
define gdk_gate
@$(gdk_gate_sh)
endef

define gdk_gate_sh
set -o pipefail; . $(GDK_GATE_LIB); \
slot="$$(gdk_gate_log $(1))"; log="$$slot.$$$$"; : > "$$log"; \
gdk_on_exit 'rm -f -- "$$log"'; \
gdk_gate_capture "$$log" -- $(4); \
status="$$GDK_GATE_EXIT"; \
summary="$$($(3))"; \
if [ "$$status" -ne 0 ]; then \
	grep -aE '$(GDK_GATE_FAIL_RE)' "$$log" | head -$(GDK_GATE_FAIL_LINES) \
		|| tail -$(GDK_GATE_FAIL_LINES) "$$log"; \
	summary="FAIL (exit $$status) — $$summary"; \
fi; \
mv -f -- "$$log" "$$slot"; \
gdk_gate_verdict $(2) "$$summary" "$$slot"; \
exit "$$status"
endef

# Only what this file defines; the tier file declares its own.
.PHONY: help shell check precommit verify milestone \
        gdk-tiers-none-precommit gdk-tiers-none-verify gdk-tiers-skipped-verify

help: ## Show this help (authoritative target list)
	@echo "make <target> — the gate framework from Makefile.gates, plus this project's tiers and its own"
	@echo
	@{ grep -hE '^[a-zA-Z0-9_-]+:.*?## .*$$' $(MAKEFILE_LIST) || true; } \
		| sort -u \
		| awk 'BEGIN {FS = ":.*?## "}; {printf "  \033[36m%-18s\033[0m %s\n", $$1, $$2}'
	@echo
	@echo 'Args: ARGS="…"  VERBOSE=1     Tiers: $(GDK_TIERS_MK) -> precommit=[$(strip $(GDK_PRECOMMIT_TIERS))] verify=[$(strip $(GDK_VERIFY_EFFECTIVE))]'
	@echo 'check runs: shell $(GDK_CHECKS)'
	@echo 'Gates print ONE verdict line naming .gate-reports/<gate>.log; VERBOSE=1 streams it.'

# --- Aggregate gates ----------------------------------------------------------
# `shell` is the one gate this file owns: shellcheck over every tracked *.sh.
# No tracked script is a PASS; a script with no shellcheck on PATH is a FAIL,
# never a skip.
shell: ## shellcheck over every tracked *.sh
	@set -o pipefail; . $(GDK_GATE_LIB); \
	log="$$(gdk_gate_log shell)"; \
	n="$$(git ls-files -- '*.sh' | wc -l | tr -d ' ')"; \
	if [ "$$n" -eq 0 ]; then gdk_gate_verdict SHELL "PASS (0 scripts)" "$$log"; exit 0; fi; \
	if ! command -v $(GDK_SHELLCHECK) >/dev/null 2>&1; then \
		echo "$(GDK_SHELLCHECK) is not on PATH" >> "$$log"; \
		gdk_gate_verdict SHELL "FAIL — $(GDK_SHELLCHECK) is not on PATH: install it, or set GDK_SHELLCHECK" "$$log"; \
		exit 2; \
	fi; \
	gdk_gate_capture "$$log" -- bash -c 'git ls-files -z -- "*.sh" | xargs -0 "$$@"' _ $(GDK_SHELLCHECK) $(GDK_SHELLCHECK_FLAGS); \
	status="$$GDK_GATE_EXIT"; \
	if [ "$$status" -ne 0 ]; then \
		tail -$(GDK_GATE_FAIL_LINES) "$$log"; \
		gdk_gate_verdict SHELL "FAIL (exit $$status) — shellcheck over $$n script(s)" "$$log"; \
		exit "$$status"; \
	fi; \
	gdk_gate_verdict SHELL "PASS ($$n scripts)" "$$log"

# `check` is `shell` then the GDK_CHECKS targets, each in its own sub-make.
# The verdict is the last line, and the exit is the worst exit any gate gave:
# `[CHECK] PASS — <m> gate(s)` or `[CHECK] FAIL — <n> of <m> gate(s) failed:
# <name>, …`. Re-entry is refused through GDK_IN_CHECK. The sub-make is
# `$${MAKE:-make}`, not `$(MAKE)`, so `make -n check` runs nothing.
check: ## Static gate: shell + every target in GDK_CHECKS
	@test -z "$(GDK_IN_CHECK)" || { echo "make check: re-entered through GDK_CHECKS — a gate target that runs \`make check\` recurses forever; drop it from that list" >&2; exit 2; }
	@worst=0; n=0; m=0; failed=; \
	for target in shell $(GDK_CHECKS); do \
		m=$$((m + 1)); \
		$${MAKE:-make} GDK_IN_CHECK=1 "$$target" && continue; \
		rc=$$?; n=$$((n + 1)); failed="$${failed:+$$failed, }$$target"; \
		[ "$$rc" -le "$$worst" ] || worst=$$rc; \
	done; \
	if [ "$$n" -eq 0 ]; then echo "[CHECK] PASS — $$m gate(s)"; \
	else echo "[CHECK] FAIL — $$n of $$m gate(s) failed: $$failed"; fi; \
	exit "$$worst"

# --- The tier seam ------------------------------------------------------------
# The kit's tier lists, read and guarded at parse time.
GDK_TIERS_MK        ?= Makefile.tiers
GDK_PRECOMMIT_TIERS ?=
GDK_VERIFY_TIERS    ?=
# DEPRECATED, remove in 4.0: the 2.x names. A non-empty GDK_MILESTONE_TIERS
# wins over GDK_VERIFY_TIERS, and GDK_MILESTONE_SKIP adds to GDK_VERIFY_SKIP.
GDK_MILESTONE_TIERS ?=
GDK_MILESTONE_SKIP  ?=
-include $(GDK_TIERS_MK)

GDK_VERIFY_EFFECTIVE = $(if $(strip $(GDK_MILESTONE_TIERS)),$(GDK_MILESTONE_TIERS),$(GDK_VERIFY_TIERS))

# The typo guard: `-include` is silent on a missing file, so a non-empty tier
# list with no file, or a tier no makefile defines, is refused here.
GDK_TIERS_DECLARED := $(strip $(GDK_PRECOMMIT_TIERS) $(GDK_VERIFY_EFFECTIVE))
ifneq (,$(GDK_TIERS_DECLARED))
ifeq (,$(wildcard $(GDK_TIERS_MK)))
$(error GDK_TIERS_MK=$(GDK_TIERS_MK) does not exist yet a tier list names [$(GDK_TIERS_DECLARED)] — `-include` of a missing file is silent by design and this is the typo that silence hides. Point GDK_TIERS_MK at the tier file or clear GDK_PRECOMMIT_TIERS / GDK_VERIFY_TIERS)
endif
# Explicit target names from the files, since 3.81 has no target introspection;
# a tier defined only by a pattern rule is invisible here.
GDK_TIERS_TARGETS := $(shell awk '/^[A-Za-z0-9][A-Za-z0-9._\/-]*[ \t]*:([^=]|$$)/ { sub(/[ \t]*:.*/, ""); print }' $(MAKEFILE_LIST))
GDK_TIERS_ORPHAN_PRECOMMIT := $(filter-out $(GDK_TIERS_TARGETS),$(GDK_PRECOMMIT_TIERS))
GDK_TIERS_ORPHAN_VERIFY    := $(filter-out $(GDK_TIERS_TARGETS),$(GDK_VERIFY_EFFECTIVE))
ifneq (,$(GDK_TIERS_ORPHAN_PRECOMMIT))
$(error GDK_PRECOMMIT_TIERS names a tier no makefile defines: [$(GDK_TIERS_ORPHAN_PRECOMMIT)] — declared for $(GDK_TIERS_MK); a gate list that quietly gets shorter is the one failure a gate must never have)
endif
ifneq (,$(GDK_TIERS_ORPHAN_VERIFY))
$(error GDK_VERIFY_TIERS names a tier no makefile defines: [$(GDK_TIERS_ORPHAN_VERIFY)] — declared for $(GDK_TIERS_MK); a gate list that quietly gets shorter is the one failure a gate must never have)
endif
endif

# Every declared tier is phony: a same-named directory would otherwise make
# the sub-make skip that goal as up to date, silently.
.PHONY: $(GDK_PRECOMMIT_TIERS) $(GDK_VERIFY_EFFECTIVE)

# The empty case announces itself, as a prerequisite so it is neither timed nor captured.
define gdk_tiers_none
@echo "[TIERS] $(1) is empty — this gate is \`check\` alone; $(GDK_TIERS_MK) $(if $(wildcard $(GDK_TIERS_MK)),declares no tier for it,is not present)"
endef

gdk-tiers-none-precommit:
	$(call gdk_tiers_none,GDK_PRECOMMIT_TIERS)

gdk-tiers-none-verify:
	$(call gdk_tiers_none,GDK_VERIFY_TIERS)

# CI can run a verify tier as a job of its own: a workflow runs the tier
# concurrently and sets GDK_VERIFY_SKIP=<tier>. A tier named here leaves
# `verify` and the gate SAYS so; a name no verify tier carries leaves nothing.
GDK_VERIFY_SKIP    ?=
GDK_VERIFY_SKIPPED  = $(filter $(GDK_VERIFY_SKIP) $(GDK_MILESTONE_SKIP),$(GDK_VERIFY_EFFECTIVE))
GDK_VERIFY_RUN      = $(filter-out $(GDK_VERIFY_SKIP) $(GDK_MILESTONE_SKIP),$(GDK_VERIFY_EFFECTIVE))

gdk-tiers-skipped-verify:
	@echo "[TIERS] verify skips [$(strip $(GDK_VERIFY_SKIPPED))] — GDK_VERIFY_SKIP names them, so another job runs them or nothing does"

# --- The compositions ---------------------------------------------------------
# `precommit` and `verify` run `check` plus the declared tiers as the goals of
# one sub-make inside a slot of their own name. Only the members reach the
# console: the composition's own verdict line goes to its transcript.
# `make -n` still runs nothing. The transcript is per run and renamed onto the
# slot, as in `gdk_gate`.
# $(call gdk_composition,<log slot>,<TAG>,<goals...>)
define gdk_composition
@set -o pipefail; . $(GDK_GATE_LIB); \
slot="$$(gdk_gate_log $(1))"; log="$$slot.$$$$"; : > "$$log"; \
gdk_on_exit 'rm -f -- "$$log"'; verbose="$$VERBOSE"; \
VERBOSE=1 gdk_gate_capture "$$log" -- env VERBOSE="$$verbose" $${MAKE:-make} $(3); \
status="$$GDK_GATE_EXIT"; \
summary="PASS ($(strip $(3)))"; \
[ "$$status" -eq 0 ] || summary="FAIL (exit $$status) — $(strip $(3))"; \
gdk_gate_verdict $(2) "$$summary" "$$slot" >> "$$log"; \
mv -f -- "$$log" "$$slot"; \
exit "$$status"
endef

precommit: $(if $(GDK_PRECOMMIT_TIERS),,gdk-tiers-none-precommit) ## Per-change gate: check + GDK_PRECOMMIT_TIERS
	$(call gdk_composition,precommit,PRECOMMIT,check $(GDK_PRECOMMIT_TIERS))

verify: $(if $(GDK_VERIFY_EFFECTIVE),,gdk-tiers-none-verify) $(if $(GDK_VERIFY_SKIPPED),gdk-tiers-skipped-verify) ## Full gate: check + GDK_VERIFY_TIERS, less GDK_VERIFY_SKIP
	$(call gdk_composition,verify,VERIFY,check $(GDK_VERIFY_RUN))

# DEPRECATED, remove in 4.0: the 2.x name of `verify`, kept so game CI that
# still says `make milestone` keeps working until the game renames the call.
milestone: verify ## Deprecated alias of verify (removed in 4.0)
