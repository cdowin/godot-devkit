# Makefile.tiers — the Godot tier roster, on the seam Makefile.gates `-include`s.
#
# `godot-devkit install-runners` writes this file; `--force` overwrites it and
# `--diff` shows what a re-install would change. The gate FRAMEWORK — `check`,
# `precommit`, `verify`, `help`, the `gdk_gate` capture define — is
# Makefile.gates (`godot-devkit install-gates`), which your Makefile
# `include`s; that include `-include`s THIS file and reads the two tier lists
# it declares. Your Makefile is two lines plus whatever is yours:
#
#     GDK_CHECKS := godot-check
#     include Makefile.gates
#
# and godot-devkit itself is LOCKED by uv: a `godot-devkit==X.Y.Z` dev
# dependency in pyproject.toml, from this kit's index, hash-pinned in uv.lock
# and run as `uv run --frozen godot-devkit` (`install-runners` prints the
# pyproject block). The legacy pin, `GODOT_DEVKIT_VERSION := vX.Y.Z` above the
# include, still works and wins over the lock, with a warning — keep one.
#
# The Godot CHECKS join `check` by name in GDK_CHECKS, never by a fork of the
# include: `godot-check` is `godot-devkit check all` — the eight Godot gates,
# narrowed by `[roster] checks` in godot-devkit.toml. The static gates below
# that boot no engine (`hermetic-scan`, `runners-self-test`, `uid-scan`) are
# one more name each in GDK_CHECKS, when the tree has decided to pay them. The
# engine-boot guard's own corpus is NOT one of them: this kit's tests replay
# it before a release, and a consumer gate that replays it again proves
# nothing new.
#
# A BUILDER RUNS `make spot SYS=<slice>`: gdlint and a compile of only the .gd
# files changed vs BASE, then the unit slice — under 30 s on a quiet machine.
# The wide tiers are the integrator's, once per batch. `precommit` is retired
# for that use: it still runs (check + spot) and says so on its first line.
#
# EVERY GATE PRINTS ONE LINE: its verdict, naming .gate-reports/<gate>.log;
# `VERBOSE=1` streams the transcript. parse, lint, warnings and unit publish
# their own verdict from inside the runner and are not wrapped again (a gate
# wrapped twice reports the wrapper's summary and files the runner's verdict
# in a log nobody opens); the rest go through the include's `gdk_gate`.
# `import-cache` and `integration-list` are tools, not gates: the first has an
# outcome, the second's output IS the list. GNU make 3.81 is the floor.

# The godot-devkit command, resolved in this order:
#   1. GODOT_DEVKIT set by the caller — used as is, nothing to resolve (the
#      package's own tree runs it from src/ that way).
#   2. GODOT_DEVKIT_VERSION set above the include — the legacy uvx pin, built
#      from the git tag on every call, exactly as before the lock existed. When
#      uv.lock ALSO names the kit this warns (two pins of one tool ship two
#      products) and still runs the pin: a minor never makes you edit a line.
#   3. uv.lock at the repo root names godot-devkit — the locked shape, run as
#      `uv run --frozen godot-devkit`: uv syncs .venv to the lock first, so a
#      pulled lock bump takes effect on the next make, and --frozen never
#      rewrites the lock. What .venv already holds decides nothing.
# Neither is refused, naming the locked shape first.
ifeq ($(origin GODOT_DEVKIT),undefined)
GDK_LOCKED := $(if $(wildcard uv.lock),$(shell grep -qx 'name = "godot-devkit"' uv.lock && echo yes))
ifdef GODOT_DEVKIT_VERSION
ifneq ($(GDK_LOCKED),)
$(warning godot-devkit is pinned twice — uv.lock names it AND `GODOT_DEVKIT_VERSION := $(GODOT_DEVKIT_VERSION)` is in your Makefile; running the GODOT_DEVKIT_VERSION pin. Delete the GODOT_DEVKIT_VERSION line to use the lock)
endif
GODOT_DEVKIT := uvx --from "git+https://github.com/cdowin/godot-devkit@$(GODOT_DEVKIT_VERSION)" godot-devkit
else ifneq ($(GDK_LOCKED),)
GODOT_DEVKIT := uv run --frozen godot-devkit
else
$(error godot-devkit is not pinned — lock it: add `godot-devkit==X.Y.Z` to the dev dependency group in pyproject.toml, with the index block `godot-devkit install-runners` prints, and run `uv sync` (it writes uv.lock, which names the kit; make then runs `uv run --frozen godot-devkit`). The legacy pin, `GODOT_DEVKIT_VERSION := vX.Y.Z` in your Makefile ABOVE `include Makefile.gates`, still works; or set GODOT_DEVKIT to the command that runs the package)
endif
endif

# Where `install-runners` put what this file calls (GDK_DEV_DIR is the
# include's). Moving them means setting these; after the write the files are
# yours.
GDK_DEV_DIR     ?= tools/dev
GDK_RUNNERS_DIR ?= $(GDK_DEV_DIR)/runners
GDK_HOOKS_DIR   ?= tools/hooks

# Passed THROUGH to the runners, which each carry the real default. Declared
# empty rather than defaulted here: every runner reads `${GDK_X:-<default>}`,
# so an exported empty value takes the runner's default and this file never
# holds a second copy of it.
#   GDK_GODOT           the engine binary (runner default: `godot`)
#   GDK_SMOKE_SCENARIO  what `make smoke` boots (runner default: `smoke`)
#   GDK_GUT_CMDLN       GUT's entry point (default: res://addons/gut/gut_cmdln.gd)
GDK_GODOT          ?=
GDK_SMOKE_SCENARIO ?=
GDK_GUT_CMDLN      ?=
export GDK_GODOT GDK_SMOKE_SCENARIO GDK_GUT_CMDLN
# The include's library, which the unwrapped runners source for their verdict line.
export GDK_GATE_LIB

# Arguments, overridden on the command line (ARGS is the include's):
#   SYS  — unit slice(s)            make unit SYS="input protocol"
#   ARGS — passthrough              make integration ARGS="--system input"
#   NAME — scenario / capture       make scenario NAME=boot_to_hub
#   REF  — the diff base            make integration-diff REF=origin/main
#   BASE — the spot check's base    make spot BASE=origin/main SYS=input
SYS  ?=
NAME ?=
REF  ?= HEAD
BASE ?= main

# What the include's compositions run AFTER `check`. `precommit` is `spot`
# alone: a builder's proof is the spot check, and the batch's is the
# integrator's (`integration-diff` is smoke plus whatever the change's
# declared coverage selects). `verify` is the full gate. (3.x reads the old
# name GDK_MILESTONE_TIERS as an alias; remove in 4.0.)
GDK_PRECOMMIT_TIERS := spot
GDK_VERIFY_TIERS := parse lint warnings unit integration-all

.PHONY: parse lint spot warnings unit integration integration-all integration-diff \
        integration-list scenario smoke capture import-cache \
        godot-check uid-scan hermetic-scan runners-self-test gdk-precommit-retired

# --- Tier 1: static / fast gates ---------------------------------------------
parse: ## Compile gate — every .gd compiles + the headless boot is clean
	@bash $(GDK_RUNNERS_DIR)/parse.sh

lint: ## gdlint static analysis over every tracked source dir
	@bash $(GDK_RUNNERS_DIR)/lint.sh

# The builder's one command. spot.sh lints and compiles only the .gd files
# changed vs the merge base with BASE (no changed .gd is a PASS, census 0);
# then the unit slice SYS names runs. Both run, each prints its own verdict
# and files a receipt, and the exit is the worse of the two.
spot: export GDK_SPOT_BASE = $(BASE)
spot: ## The builder's check: lint + compile of the .gd changed vs BASE (default main), then unit SYS=<slice>
	@bash $(GDK_RUNNERS_DIR)/spot.sh; rc=$$?; \
	bash $(GDK_RUNNERS_DIR)/unit.sh $(SYS); u=$$?; \
	[ "$$u" -le "$$rc" ] || rc=$$u; exit "$$rc"

# `precommit` is the include's composition; this adds a prerequisite and no
# recipe. While GDK_PRECOMMIT_TIERS names `spot`, it prints one line saying
# the tier is retired and what replaced it.
precommit: gdk-precommit-retired
gdk-precommit-retired:
	@$(if $(filter spot,$(GDK_PRECOMMIT_TIERS)),echo "[PRECOMMIT] retired: it runs check + spot. A builder runs \`make spot SYS=<slice>\`; the integrator proves the batch once")

warnings: ## GDScript analyzer-warnings gate (the editor-only ones)
	@bash $(GDK_RUNNERS_DIR)/warnings.sh

# The eight Godot checks, as ONE member of `make check` — name it in
# GDK_CHECKS. Their roster is `[roster] checks` in godot-devkit.toml; an unknown
# name there is refused, never skipped.
godot-check: ## The Godot gates (`godot-devkit check all`) — name it in GDK_CHECKS
	$(call gdk_gate,godot-check,GODOT,$(GDK_SUM_CHECKS),$(GODOT_DEVKIT) check all)

uid-scan: ## .uid drift guard (script-ref <-> .gd.uid, sidecar presence, canonicality)
	$(call gdk_gate,uid-scan,UID,$(GDK_SUM_CHECKS),$(GODOT_DEVKIT) check uid)

hermetic-scan: ## Hermeticity gate (a headless run's sandbox HOME self-destructs)
	$(call gdk_gate,hermetic-scan,HERMETIC,$(GDK_SUM_TAIL),bash $(GDK_RUNNERS_DIR)/hermetic_run_scan.sh)

# Derived, not listed: every installed runner's own corpus, so a runner that
# lands tomorrow is proven the day it arrives. A census of ZERO says so and
# fails — it cannot tell an uninstalled tree from a passing one, and a repo
# that moved its runners without setting GDK_RUNNERS_DIR is exactly that tree.
# The census counts RUNNERS only: the library is always exactly one, so
# counting it would put the floor permanently out of reach.
runners-self-test: ## Every installed runner's --self-test corpus
	@set -o pipefail; . $(GDK_GATE_LIB); \
	log="$$(gdk_gate_log runners-self-test)"; count=0; fail=''; \
	for s in $(GDK_DEV_DIR)/gdk_runners.sh $(GDK_RUNNERS_DIR)/*.sh; do \
		[ -f "$$s" ] || continue; \
		case "$$s" in $(GDK_RUNNERS_DIR)/*) count=$$((count + 1));; esac; \
		echo "=== $$s --self-test ===" >> "$$log"; \
		gdk_gate_capture "$$log" -- bash "$$s" --self-test; \
		[ "$$GDK_GATE_EXIT" -eq 0 ] || fail="$$fail $$(basename "$$s")"; \
	done; \
	if [ "$$count" -eq 0 ]; then \
		gdk_gate_verdict RUNNERS "FAIL — no runners under $(GDK_RUNNERS_DIR); run godot-devkit install-runners" "$$log"; \
		exit 2; \
	fi; \
	if [ -n "$$fail" ]; then \
		grep -aE '$(GDK_GATE_FAIL_RE)' "$$log" | head -$(GDK_GATE_FAIL_LINES) || true; \
		gdk_gate_verdict RUNNERS "FAIL on$$fail" "$$log"; exit 1; \
	fi; \
	gdk_gate_verdict RUNNERS "the library + $$count runner corpora PASS" "$$log"

# --- Tier 2: tests ------------------------------------------------------------
unit: ## Unit tier (GUT, no boot). Slice with SYS="input ..."
	@bash $(GDK_RUNNERS_DIR)/unit.sh $(SYS)

# The scenario family goes through the capture helper, like every other target
# whose tool publishes no verdict of its own: one verdict line naming
# .gate-reports/<gate>.log, VERBOSE=1 streams it. (`scenario.sh -v` remains the
# hand-run flag for the ENGINE transcript, which lands in .scenario-reports/
# and is named in the runner's own output.)
#
# A run its receipt covers boots nothing: the runner creates the file
# GDK_GATE_UNMEASURED names. Nothing in 3.0 reads it (it marked a run that
# filed no cost row); each recipe still clears it, so a marker left by an
# earlier run cannot be mistaken for this one's.
integration integration-all integration-diff scenario smoke: export GDK_GATE_UNMEASURED = $(CURDIR)/.gate-reports/.$@.unmeasured
integration: ## Integration tier. Pass ARGS="--all|--system <dir>|--diff <ref>|<names>"
	@rm -f -- "$$GDK_GATE_UNMEASURED"
	$(call gdk_gate,integration,INTEGRATION,$(GDK_SUM_TAIL),bash $(GDK_RUNNERS_DIR)/integration.sh $(if $(ARGS),$(ARGS),--all))

integration-all: ## Every integration scenario, one process each, N in parallel. GDK_SHARD=i/n runs slice i of n
	@rm -f -- "$$GDK_GATE_UNMEASURED"
	$(call gdk_gate,integration-all,INTEGRATION,$(GDK_SUM_TAIL),bash $(GDK_RUNNERS_DIR)/integration.sh --all$(if $(GDK_SHARD), --shard $(GDK_SHARD)))

# The per-change slice: every scenario whose header declares it covers a path
# the diff against REF touched, plus the smoke scenario. A touched scenario runs;
# a touched piece of the tier's own ground (fixtures, the base class, the
# runners) makes the whole tier the honest slice. REF defaults to HEAD — the
# uncommitted change — so a clean tree runs exactly what `smoke` runs.
integration-diff: ## The scenarios covering what the diff against REF touched, plus smoke
	@rm -f -- "$$GDK_GATE_UNMEASURED"
	$(call gdk_gate,integration-diff,INTEGRATION,$(GDK_SUM_TAIL),bash $(GDK_RUNNERS_DIR)/integration.sh --diff $(REF))

# The roster `--all` boots, one repo-relative path per line, booting nothing.
# Not a gate — the list IS the output — and it lives here rather than as a
# bare `bash … --list` because this file is where the runner's exports live:
# `check test-shape` asks its header rule of exactly this list, THROUGH this
# target, so a keep-list exported above reaches `--list` the same way it
# reaches `integration`. Whoever runs the gate gets the same census.
integration-list: ## The roster --all would boot, one path per line (what check test-shape asks)
	@bash $(GDK_RUNNERS_DIR)/integration.sh --list

scenario: ## One scenario, cold:  make scenario NAME=<scenario>
	@test -n "$(NAME)" || { echo "usage: make scenario NAME=<scenario>"; exit 2; }
	@rm -f -- "$$GDK_GATE_UNMEASURED"
	$(call gdk_gate,scenario,SCENARIO,$(GDK_SUM_TAIL),bash $(GDK_RUNNERS_DIR)/scenario.sh $(NAME))

smoke: ## The smoke scenario (GDK_SMOKE_SCENARIO) — the shortest proof the game boots
	@rm -f -- "$$GDK_GATE_UNMEASURED"
	$(call gdk_gate,smoke,SMOKE,$(GDK_SUM_TAIL),bash $(GDK_RUNNERS_DIR)/integration.sh --smoke)

capture: ## Headed visual capture (LOCAL, needs a display) -> PNG:  make capture NAME=<scenario>
	@test -n "$(NAME)" || { echo "usage: make capture NAME=<scenario>"; exit 2; }
	$(call gdk_gate,capture,CAPTURE,$(GDK_SUM_TAIL),bash $(GDK_RUNNERS_DIR)/capture.sh $(NAME))

import-cache: ## Rebuild the .godot import cache, sandboxed (new class_name, moved files, stale art)
	@bash $(GDK_RUNNERS_DIR)/import_cache.sh
