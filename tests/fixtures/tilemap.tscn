[gd_scene load_steps=3 format=3 uid="uid://cfixturetile"]

[ext_resource type="TileSet" uid="uid://dtilesettile" path="res://fixtures/tiles.tres" id="1_tiles"]
[ext_resource type="Script" uid="uid://dtilecontr00" path="res://fixtures/contract.gd" id="2_contract"]

[node name="Room" type="Node2D"]

; A 4x3 slab of src=1 atlas=(0,0) with one corner of another kind, one cell of a
; second source, one outlier at (-2,5), and a hole at (2,1) — enough shape for
; bounds, a histogram, per-column/row counts and an `--at` miss.
[node name="FloorLayer" type="TileMapLayer" parent="."]
position = Vector2(0, 8)
tile_set = ExtResource("1_tiles")
tile_map_data = PackedByteArray("AAAAAAAAAQACAAEAAAABAAAAAQAAAAAAAAACAAAAAQAAAAAAAAADAAAAAQAAAAAAAAAAAAEAAQAAAAAAAAABAAEAAQAAAAAAAAADAAEAAQAAAAAAAAAAAAIAAQAAAAAAAAABAAIAAQAAAAAAAAACAAIAAQAAAAAAAAADAAIAAgAAAAAAAQD+/wUAAQAAAAAAAAA=") ; the grid, in one line

; A layer that has never been painted: no `tile_map_data` property at all.
[node name="EmptyLayer" type="TileMapLayer" parent="."]
tile_set = ExtResource("1_tiles")

[node name="Nested" type="Node2D" parent="."]

[node name="WallLayer" type="TileMapLayer" parent="Nested"]
tile_map_data = PackedByteArray("AAAAAAAAAwAAAAAAAAA=")

[node name="Deep" type="Node2D" parent="."]

; Same NAME as the layer above, under a different parent: neither owns the bare
; name, so addressing by name is ambiguous and the tools must refuse.
[node name="WallLayer" type="TileMapLayer" parent="Deep"]
tile_set = ExtResource("1_tiles")

[node name="Contract" type="Node2D" parent="."]
script = ExtResource("2_contract")
label = "not a layer at all"
