#!/usr/bin/env bash
# pre-push — tracked git hook (core.hooksPath=tools/hooks). Blocks a direct
# push to a protected branch, always. It runs no gate: a hook refuses only an
# act that cannot be undone or that harms another tree.
# Stdin: one `<local_ref> <local_sha> <remote_ref> <remote_sha>` per ref.
set -eu

# --- project config (yours to edit after install — the file is your repo's) --
# Branch names (exact, space-separated) that must never be pushed directly.
PROTECTED_BRANCHES="main"
# -----------------------------------------------------------------------------

# A header carried from an older install may lack a key: it runs at its stock value.
declare -p PROTECTED_BRANCHES >/dev/null 2>&1 || PROTECTED_BRANCHES="main"

while read -r _local_ref _local_sha remote_ref _remote_sha; do
	[ -z "${remote_ref:-}" ] && continue
	# Exact match: a substring match would block refs/heads/maintenance for "main".
	for protected in $PROTECTED_BRANCHES; do
		if [ "$remote_ref" = "refs/heads/${protected}" ]; then
			echo "" >&2
			echo "BLOCKED: Direct push to ${protected} is not allowed." >&2
			echo "Use the PR workflow instead (see this repo's git rules)." >&2
			echo "" >&2
			exit 1
		fi
	done
done

exit 0
